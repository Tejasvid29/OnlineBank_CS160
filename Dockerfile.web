# Web frontend: builds the Expo web app, then serves the static files with nginx.
#
# EXPO_PUBLIC_API_URL is inlined into the bundle at build time (and is public), so it is a build argument:
#   docker build -f Dockerfile.web --build-arg EXPO_PUBLIC_API_URL=http://localhost:8000 .
# Leave it empty to build the demo-mode app (sample data, no backend).

FROM node:22-alpine AS build
WORKDIR /app
ENV CI=1 EXPO_NO_TELEMETRY=1

COPY package.json package-lock.json ./
RUN npm ci

COPY . .
ARG EXPO_PUBLIC_API_URL=
ENV EXPO_PUBLIC_API_URL=$EXPO_PUBLIC_API_URL
RUN npm run build:web

FROM nginx:1.27-alpine
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
HEALTHCHECK --interval=15s --timeout=3s --retries=3 CMD wget -qO /dev/null http://127.0.0.1/ || exit 1
