# Optional overrides for docker-compose.yml. Copy to docker/.env (git-ignored) and run:
#   docker compose --env-file docker/.env up --build
# Everything works without this file; the defaults are for local development only.

# --- Ports
# WEB_PORT=3000
# API_PORT=8000
# SUPABASE_PORT=54331
# DB_PORT=54332
# MAILPIT_PORT=8025

# --- Addresses the browser uses. The web bundle bakes PUBLIC_API_URL in at build time (docker compose build web).
# For a phone on your Wi-Fi, use this PC's LAN address instead of localhost, e.g. http://192.168.1.20:8000
# PUBLIC_API_URL=http://localhost:8000
# SUPABASE_PUBLIC_URL=http://localhost:54331
# APP_URL=http://localhost:3000
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8081

# --- ATM search. docker-compose.yml already includes a default free-tier Geoapify key; set your own
# (free from https://www.geoapify.com) to use a different quota. An empty value makes the ATM screen return a 503.
# GEOAPIFY_API_KEY=

# --- Secrets. Defaults are public development values; change all four together if you expose the stack beyond localhost
# (anon/service keys are HS256 JWTs signed with JWT_SECRET and "role": "anon" / "service_role").
# POSTGRES_PASSWORD=
# JWT_SECRET=
# ANON_KEY=
# SERVICE_ROLE_KEY=

# --- Seed users (docker compose run --rm seed)
# SEED_PASSWORD=DemoPass2026!
# SEED_ADMIN_EMAIL=admin@example.com
# E2E_TEST_EMAIL=e2e-user@example.com
# E2E_TEST_PASSWORD=DemoPass2026!
# E2E_RECIPIENT_EMAIL=e2e-recipient@example.com
# E2E_RECIPIENT_PASSWORD=DemoPass2026!

# --- Emails the backend sends itself (account-locked notice, month-end statements). Unset = skipped.
# RESEND_API_KEY=
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASSWORD=
