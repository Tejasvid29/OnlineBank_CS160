SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server-side only. Bypasses row-level security; never expose it to the frontend or commit it.
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
# Free key from https://www.geoapify.com (3,000 credits/day). Server-side only; never expose it to the frontend or commit it.
GEOAPIFY_API_KEY=
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
